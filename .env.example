# Liquidation Trading System - Environment Configuration
# Copy to .env and fill in values

# =============================================================================
# HYPERLIQUID NODE
# =============================================================================

# Node adapter gRPC server (default: localhost:50051)
HL_ADAPTER_ADDRESS=localhost:50051

# Node proxy URL for direct node access (default: localhost:8080)
HL_NODE_PROXY_URL=http://localhost:8080

# Enable node mode (true = use HL node, false = WebSocket only)
USE_HL_NODE=true

# Enable wallet indexer (discovers large positions)
ENABLE_HL_INDEXER=true

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Enable observatory REST API (default: false)
ENABLE_OBSERVATORY=false

# Observatory port (default: 8080)
OBSERVATORY_PORT=8080

# =============================================================================
# DIAGNOSTICS
# =============================================================================

# Enable diagnostic output (verbose logging)
ENABLE_DIAG=false

# M2 node creation tracing
DIAG_M2=false

# Mandate emission tracing
DIAG_MANDATE=false

# =============================================================================
# API KEYS (Optional)
# =============================================================================

# Coinglass API (whale tracking)
COINGLASS_API_KEY=

# GitHub token (for MCP integration)
GITHUB_TOKEN=

# Binance API (not used for paper trading)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# DATABASE (PostgreSQL - not currently used, SQLite is default)
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=liquidation_trading
DB_USER=postgres
DB_PASSWORD=
